# Copy to /opt/webscraper/.env on the Droplet (chmod 600). Never commit the real file.

# Public hostname Caddy serves (e.g. scraper.example.com)
SCRAPER_HOST=

DatabaseProvider=PostgreSQL
ConnectionStrings__DefaultConnection=

ScraperSettings__DataProvider=ApiSports
ScraperSettings__Providers__ApiSports__ApiKey=

Jwt__SigningKey=

InitialAdmin__Email=
InitialAdmin__Password=

ASPNETCORE_ENVIRONMENT=Production
